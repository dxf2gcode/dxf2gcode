# Own Grbl 1.1 laser-motion demonstration, GPL-3.0-or-later.
# Requires Grbl laser mode configured separately. Zero power intentionally.
# Never replace all S0 words when adapting: travel/end must remain off.
[Version]
config_version = 8.3
[General]
output_text = Grbl 1.1 - laser zero-power demonstration
output_format = .nc
output_type = g-code
abs_export = True
export_arcs_as_lines = True
code_begin_units_mm = G21
code_begin_units_in = G20
code_begin_prog_abs = G90
code_begin_prog_inc = G91
code_begin = "G17 G94 G40%nlM5 S0"
code_end = "M5 S0%nlM2%nl"
[Tool_Change]
return_state = legacy
[Program]
tool_change = ""
feed_change = "F%feed%nl"
rap_pos_plane = "M5 S0%nlG0 X%XE Y%YE%nl"
rap_pos_depth = ""
lin_mov_plane = "G1 X%XE Y%YE%nl"
lin_mov_xyz = ""
lin_mov_depth = ""
lin_mov_drill = ""
lin_ret_drill = ""
arc_int_cw = ""
arc_int_ccw = ""
cutter_comp_off = ""
cutter_comp_left = ""
cutter_comp_right = ""
pre_shape_cut = "M4 S0%nl"
post_shape_cut = "M5 S0%nl"
comment = ""
